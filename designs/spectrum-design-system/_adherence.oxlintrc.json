{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/content/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|name|size|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, alt, name, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|fillStyle|icon|key|ref|className|style)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, variant, fillStyle, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:neutral|accent|positive|notice|negative)$/]",
        "message": "<Badge> variant must be one of 'neutral' | 'accent' | 'positive' | 'notice' | 'negative'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='fillStyle'] > Literal[value!=/^(?:bold|subtle)$/]",
        "message": "<Badge> fillStyle must be one of 'bold' | 'subtle'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|fillStyle|size|icon|isDisabled|onPress|onClick|type|key|ref|className|style)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, fillStyle, size, icon, isDisabled, onPress, onClick, type."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|accent|negative|quiet)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'accent' | 'negative' | 'quiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='fillStyle'] > Literal[value!=/^(?:fill|outline)$/]",
        "message": "<Button> fillStyle must be one of 'fill' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:S|M|L|XL)$/]",
        "message": "<Button> size must be one of 'S' | 'M' | 'L' | 'XL'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|isSelected|isIndeterminate|isDisabled|onChange|key|ref|className|style)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: children, isSelected, isIndeterminate, isDisabled, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:isOpen|onClose|title|children|footer|width|key|ref|className|style)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: isOpen, onClose, title, children, footer, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|className|style|key|ref|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|variant|size|isDisabled|onPress|onClick|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, variant, size, isDisabled, onPress, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:quiet|secondary)$/]",
        "message": "<IconButton> variant must be one of 'quiet' | 'secondary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:S|M)$/]",
        "message": "<IconButton> size must be one of 'S' | 'M'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Menu'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|items|variant|size|onAction|key|ref|className|style|children)$/]",
        "message": "<Menu> doesn't accept that prop. Declared props: label, icon, items, variant, size, onAction."
      },
      {
        "selector": "JSXOpeningElement[name.name='Menu'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|accent|negative|quiet)$/]",
        "message": "<Menu> variant must be one of 'primary' | 'secondary' | 'accent' | 'negative' | 'quiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Menu'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:S|M|L|XL)$/]",
        "message": "<Menu> size must be one of 'S' | 'M' | 'L' | 'XL'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Picker'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|items|selectedKey|defaultSelectedKey|placeholder|isDisabled|onSelectionChange|key|ref|className|style|children)$/]",
        "message": "<Picker> doesn't accept that prop. Declared props: label, items, selectedKey, defaultSelectedKey, placeholder, isDisabled, onSelectionChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|ariaLabel|value|isIndeterminate|showValue|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: label, ariaLabel, value, isIndeterminate, showValue."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|placeholder|value|defaultValue|isDisabled|onChange|onClear|key|ref|className|style|children)$/]",
        "message": "<SearchField> doesn't accept that prop. Declared props: label, placeholder, value, defaultValue, isDisabled, onChange, onClear."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|isSelected|isDisabled|onChange|key|ref|className|style)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: children, isSelected, isDisabled, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|selectedKey|defaultSelectedKey|children|onSelectionChange|key|ref|className|style)$/]",
        "message": "<Tabs> doesn't accept that prop. Declared props: items, selectedKey, defaultSelectedKey, children, onSelectionChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|description|errorMessage|isRequired|isDisabled|placeholder|value|defaultValue|type|onChange|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: label, description, errorMessage, isRequired, isDisabled, placeholder, value, defaultValue, type, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:toasts|onDismiss|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: toasts, onDismiss."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
